# ==========================================================================
# Настройки бэкенда формы обратной связи.
# Скопируйте этот файл в .env и заполните своими данными:
#   cp .env.example .env
# Файл .env НЕ должен попадать в git.
# ==========================================================================

# Порт, на котором слушает бэкенд (nginx проксирует /api на этот порт)
PORT=3000

# ---------- Отправка писем ----------
# Куда приходят заявки
MAIL_TO=riool@riool.ru

# Отправитель. Должен быть подтверждён в аккаунте SMTP-провайдера
MAIL_FROM=riool@riool.ru

# Тема письма с заявкой
MAIL_SUBJECT_PREFIX=Заявка с riool-hw.ru

# ---------- SMTP-провайдер ----------
# Вариант 1: Яндекс Почта (https://yandex.ru/support/yandex-360/customers/mail/ru/mail-clients/others.html)
#   пароль приложения: https://account.yandex.ru/app-passwords
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true

# Вариант 2: Gmail
#   включите двухфакторную аутентификацию и создайте пароль приложения
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Вариант 3: Mail.ru
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true

# Вариант 4: отправка без SSL через STARTTLS (порт 587)
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=riool@riool.ru
SMTP_PASS=ВСТАВЬТЕ_ПАРОЛЬ_ПРИЛОЖЕНИЯ_СЮДА

# ---------- Безопасность ----------
# Домены, с которых разрешено слать заявки (через запятую). Пусто — любые.
ALLOWED_ORIGINS=https://riool-hw.ru,https://www.riool-hw.ru

# Доверять заголовку X-Forwarded-For (нужно, если проксирует nginx/cloudflare)
TRUST_PROXY=true

# Секретный токен форм. Если задан, фронтенд должен слать заголовок
# X-Form-Token = sha256(значение).slice(0,32). Оставьте пустым, если не используете.
FORM_TOKEN=

# Минимальное время заполнения формы в миллисекундах (антибот)
MIN_FILL_MS=1500
