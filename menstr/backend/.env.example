# Backend configuration
# NODE_ENV=production ставится скриптом `npm start` (нужен для trust proxy за HTTPS-прокси).
# Флаг Secure у refresh-куки выставляется автоматически по req.secure.
PORT=3000
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_PASSWORD=admin123

# Разрешённые origin для CORS через запятую. Если не задано — dev-адреса Vite.
# В production (frontend раздаётся тем же сервером) CORS не требуется, настройка не обязательна.
CORS_ORIGINS=

# SMTP (optional). If not set, emails are logged to the console instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CycleTracker <no-reply@example.com>

# Path where uploaded files are stored
UPLOAD_DIR=uploads