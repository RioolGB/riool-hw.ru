{
  "name": "cycle-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend для CycleTracker",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
